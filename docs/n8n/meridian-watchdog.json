{
  "name": "Meridian · Watchdog",
  "nodes": [
    {
      "parameters": { "rule": { "interval": [{ "field": "minutes", "minutesInterval": 10 }] } },
      "name": "A cada 10 min",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [0, 0]
    },
    {
      "parameters": {
        "url": "https://<MERIDIAN_URL>/api/health",
        "options": {
          "timeout": 15000,
          "response": { "response": { "fullResponse": true, "neverError": true } }
        }
      },
      "name": "GET /api/health",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [220, 0],
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "typeValidation": "loose" },
          "conditions": [
            {
              "leftValue": "={{ $json.statusCode }}",
              "rightValue": 200,
              "operator": { "type": "number", "operation": "notEquals" }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "name": "Fora do ar?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [440, 0]
    },
    {
      "parameters": {
        "chatId": "<TELEGRAM_CHAT_ID>",
        "text": "={{ '🔴 MERIDIAN FORA DO AR · status ' + ($json.statusCode ?? 'sem resposta') + ($json.body?.db ? ' · banco ' + $json.body.db : '') }}",
        "additionalFields": { "appendAttribution": false }
      },
      "name": "Telegram",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [660, -80]
    }
  ],
  "connections": {
    "A cada 10 min": { "main": [[{ "node": "GET /api/health", "type": "main", "index": 0 }]] },
    "GET /api/health": { "main": [[{ "node": "Fora do ar?", "type": "main", "index": 0 }]] },
    "Fora do ar?": { "main": [[{ "node": "Telegram", "type": "main", "index": 0 }]] }
  },
  "settings": { "executionOrder": "v1" }
}
